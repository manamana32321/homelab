
config ddns 'global'
	option ddns_dateformat '%F %R'
	option ddns_loglines '250'
	option ddns_rundir '/var/run/ddns'
	option ddns_logdir '/var/log/ddns'

config service 'cf_origin'
	option enabled '1'
	option service_name 'cloudflare.com-v4'
	option lookup_host 'origin.json-server.win'
	option domain 'origin@json-server.win'
	option username 'Bearer'
	option password 'REPLACE_ME'
	option use_ipv6 '0'
	option ip_source 'network'
	option ip_network 'wan'
	option interface 'wan'
	option use_https '1'
	option cacert '/etc/ssl/certs'
	option dns_server '1.1.1.1'
	option check_interval '5'
	option check_unit 'minutes'
	option force_interval '24'
	option force_unit 'hours'
