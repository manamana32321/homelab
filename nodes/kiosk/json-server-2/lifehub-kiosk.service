[Unit]
Description=lifehub kiosk
PartOf=graphical-session.target
After=graphical-session.target

[Service]
EnvironmentFile=/etc/lifehub-kiosk/env
ExecStart=/usr/bin/google-chrome-stable --ozone-platform=wayland --kiosk "--app=${KIOSK_URL}" --user-data-dir=%h/.config/lifehub-kiosk --no-first-run --noerrdialogs --hide-crash-restore-bubble --password-store=basic
Restart=always
RestartSec=10
