#!/bin/sh
set -e
mode=${1:-auto}
if [ "$mode" = auto ]; then
  h=$(date +%-H)
  if [ "$h" -ge 8 ] && [ "$h" -lt 23 ]; then mode=on; else mode=sleep; fi
fi
case "$mode" in
  on)
    systemctl start weston.service
    ;;
  sleep)
    w=$(date -d 07:59:30 +%s)
    [ "$w" -gt "$(date +%s)" ] || w=$(date -d 'tomorrow 07:59:30' +%s)
    rtcwake -m no -t "$w"
    systemctl suspend
    ;;
  *)
    echo "usage: kiosk-screen [auto|on|sleep]" >&2
    exit 2
    ;;
esac
