          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_method, http_route) (rate(traces_spanmetrics_latency_bucket{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range])))",
          "refId": "p95",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, http_method, http_route) (rate(traces_spanmetrics_latency_bucket{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range])))",
          "refId": "p99",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\", http_status_code=~\"4..\"}[$__range])) or 0 * sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range]))) / sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range]))",
          "refId": "e4",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
