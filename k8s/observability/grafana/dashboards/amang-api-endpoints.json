          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\", http_status_code=~\"5..\"}[$__range])) or 0 * sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range]))) / sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range]))",
          "refId": "e5",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
