{
  "uid": "amang-api-endpoints",
  "title": "amang API 엔드포인트",
  "tags": [
    "amang",
    "tempo",
    "span-metrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "description": "Tempo span-metrics(traces_spanmetrics_*)로 본 amang-api 서버 엔드포인트 성능. Sentry 샘플링을 그대로 탄다 (kubelet probe 0%, 스테이징 봇 5%)",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"amang-api\"}, deployment_environment_name)",
          "refId": "env"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"amang-api\"}, deployment_environment_name)",
        "current": {
          "selected": true,
          "text": "production",
          "value": "production"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "route",
        "label": "라우트",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\"}, http_route)",
          "refId": "route"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\"}, http_route)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "version",
        "label": "버전",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\"}, app_version)",
          "refId": "version"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\"}, app_version)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "요청 수",
      "description": "선택한 기간 평균 초당 요청 수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx 비율",
      "description": "선택한 기간 서버 에러 응답 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
