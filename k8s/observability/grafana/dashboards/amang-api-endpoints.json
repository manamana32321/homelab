        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_method, http_route) (rate(traces_spanmetrics_calls_total{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range]))",
          "refId": "rps",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, http_method, http_route) (rate(traces_spanmetrics_latency_bucket{service=\"amang-api\", deployment_environment_name=\"$env\", http_route=~\"$route\", app_version=~\"$version\"}[$__range])))",
          "refId": "p50",
          "legendFormat": "",
