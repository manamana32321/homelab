            },
            "indexByName": {
              "http_method": 0,
              "http_route": 1,
              "Value #rps": 2,
              "Value #p50": 3,
              "Value #p95": 4,
              "Value #p99": 5,
              "Value #e4": 6,
              "Value #e5": 7
            },
            "renameByName": {
              "http_method": "메서드",
              "http_route": "라우트",
              "Value #rps": "요청/s",
              "Value #p50": "p50",
              "Value #p95": "p95",
              "Value #p99": "p99",
              "Value #e4": "4xx",
              "Value #e5": "5xx"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "요청/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
